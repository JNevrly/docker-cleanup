{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docker Cleanup",
  "version": "0.4.0",
  "identifier": "io.github.docker-cleanup.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "title": "Docker Cleanup",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "publisher": "Josef (JNevrly)",
    "homepage": "https://github.com/JNevrly/docker-cleanup",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Inspect and safely clean Docker storage",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "files": { "/usr/share/doc/docker-cleanup/copyright": "../LICENSE" }
      }
    }
  }
}
