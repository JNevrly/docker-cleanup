{
  "name": "docker-cleanup",
  "private": true,
  "version": "0.4.0",
  "description": "An evidence-led, safety-first Docker storage explorer for Linux",
  "license": "MIT",
  "author": "Josef (JNevrly)",
  "homepage": "https://github.com/JNevrly/docker-cleanup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JNevrly/docker-cleanup.git"
  },
  "bugs": {
    "url": "https://github.com/JNevrly/docker-cleanup/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'tests/browser/*.ts' package.json tsconfig.json vite.config.ts playwright.config.ts",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build --features desktop --bundles deb -- --locked"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "d3-hierarchy": "^3.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
